# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
.Python
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Secrets & Credentials — NEVER COMMIT THESE
.env
.env.*
*.pem
*.key
*.p12
service-account*.json
*-credentials.json
gcloud-service-key.json
.databrickscfg

# Terraform State — managed remotely, never locally
*.tfstate
*.tfstate.*
*.tfplan
.terraform/
.terraform.lock.hcl

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Node.js / Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databricks
.databricks/

# Docker
*.tar

# Jupyter Notebooks — output cells only (keep structure)
.ipynb_checkpoints/

# Logs
*.log
logs/

# Data files — large data files must NOT be committed
*.csv
*.parquet
*.avro
*.orc
*.json.gz

# Exceptions: small test fixture data IS allowed
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.json
